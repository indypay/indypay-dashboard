# ===========================================
# RupeeFlow Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control

# -------------------------------------------
# API Configuration
# -------------------------------------------
# Main API Base URL (used internally by Next.js)
DEV_PB_BASE_URL=https://dev-api.RupeeFlow.in

# Public API Base URL (accessible from client-side)
NEXT_PUBLIC_DEV_PB_BASE_URL=https://dev-api.RupeeFlow.in

# Alternative API URLs (if needed)
NEXT_PUBLIC_API_URL=https://dev-api.RupeeFlow.in
NEXT_PUBLIC_API_BASE_URL=https://dev-api.RupeeFlow.in

# -------------------------------------------
# Frontend Configuration
# -------------------------------------------
NEXT_PUBLIC_FE_BASE_URL=http://localhost:3000

# -------------------------------------------
# Realtime / In-app notifications (Socket.IO)
# -------------------------------------------
# Base URL for notification socket (e.g. http://localhost:4000); namespace /notifications is appended
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# -------------------------------------------
# AWS S3 Configuration
# -------------------------------------------
NEXT_PUBLIC_AWS_S3_BUCKET_URL=https://your-bucket-name.s3.amazonaws.com

# -------------------------------------------
# Authentication (Optional)
# -------------------------------------------
# AUTH_SECRET=your-secret-key-here
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# -------------------------------------------
# Environment
# -------------------------------------------
NODE_ENV=development
